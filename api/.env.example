# Copy to .env and export before starting the API (the API does not load .env itself).
MARKET_ENV=development            # "production" makes the two secrets below mandatory
MARKET_JWT_SECRET=                # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
MARKET_ADMIN_PASSWORD=            # only used when the admin user is first created
# MARKET_SIMULATION_BIN=../build/market_simulation
# MARKET_OUTPUT_DIR=../output
